# Copie para .env (cp .env.example .env). Valores de DESENVOLVIMENTO LOCAL apenas.
# Em producao real estes valores viriam de um gerenciador de segredos.

# Porta em que a API escuta (e e publicada no host)
PORT=3000

# Conexao com o PostgreSQL (o host "db" e o nome do servico no compose)
DB_HOST=db
DB_PORT=5432
DB_USER=flags
DB_PASSWORD=flags_dev_password
DB_NAME=flags
